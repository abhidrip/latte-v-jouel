# ──────────────────────────────────────────────────────────────
# Lattév Jouel — Razorpay Configuration
# Copy this file to .env and fill in your keys.
# ──────────────────────────────────────────────────────────────
# Get your keys from: https://dashboard.razorpay.com/app/keys
# Use Test keys (rzp_test_...) for development
# Use Live keys (rzp_live_...) only in production

# ► Server-side ONLY — NEVER exposed to the browser
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ► Client-side (safe to expose — this is the PUBLIC key)
# Must start with VITE_ to be available in the browser
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# ──────────────────────────────────────────────────────────────
# Lattév Jouel — Supabase Configuration
# ──────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
